# Copy to .env and fill in, or run:  python scripts/make_env.py   (.env is git-ignored: never commit it)
# Your Claude API key is NOT read from this file: set ANTHROPIC_API_KEY in your shell (see README).

# Storage (SQLite file; created on first run)
DATABASE_PATH=data/approval.db

# Who can sign in, as JSON: {"username": {"name": "...", "hash": "<argon2 hash>", "role": "approver"|"viewer", "limit": "20000.00"}}
# Make a hash with:  python -m approval hash-password     (make_env.py fills this in for you)
# Keep the single quotes: argon2 hashes contain $ signs.
APPROVERS='{"dana": {"name": "Dana Whitfield", "hash": "replace-with-an-argon2-hash", "role": "approver", "limit": "20000.00"}}'

# Cookies need HTTPS when true. false is only for http://127.0.0.1 on your own machine.
COOKIE_SECURE=false
SESSION_TTL_MINUTES=480

# Draft rules
DRAFT_TTL_HOURS=48
MAX_DRAFT_TOTAL=50000.00

# The agent: claude (needs ANTHROPIC_API_KEY) or demo (offline, rule-based, free)
EXTRACTOR=demo
EXTRACT_MODEL=claude-haiku-5-5
EXTRACT_EFFORT=low
EXTRACT_DAY_CAP_USD=1.00

# Where approved invoices go: local (this app's own table) or governed-write-api
POST_TARGET=local
WRITEAPI_URL=http://127.0.0.1:8001
WRITEAPI_KEY_ID=approval-flow
WRITEAPI_SECRET=replace-with-a-long-random-secret-at-least-32-characters
